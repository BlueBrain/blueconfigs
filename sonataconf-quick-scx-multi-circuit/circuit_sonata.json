{
    "manifest": {
        "$NETWORK_DIR": "../_usecase3"
    },
    "networks": {
        "nodes": [
            {
                "nodes_file": "$NETWORK_DIR/nodes_A.h5",
                "populations": {
                    "NodeA": {
                        "type": "biophysical",
                        "morphologies_dir": "$NETWORK_DIR/components/CircuitA/morphologies/swc",
                        "biophysical_neuron_models_dir": "$NETWORK_DIR/components/CircuitA/hoc",
                        "alternate_morphologies": {
                            "neurolucida-asc": "$NETWORK_DIR/components/CircuitA/morphologies/asc"
                        }
                    }
                }
            },
            {
                "nodes_file": "$NETWORK_DIR/nodes_B.h5",
                "populations": {
                    "NodeB": {
                        "type": "biophysical",
                        "morphologies_dir": "$NETWORK_DIR/components/CircuitB/morphologies/swc",
                        "biophysical_neuron_models_dir": "$NETWORK_DIR/components/CircuitB/hoc",
                        "alternate_morphologies": {
                            "neurolucida-asc": "$NETWORK_DIR/components/CircuitB/morphologies/asc"
                        }
                    }
                }
            }
        ],
        "edges": [
            {
                "edges_file": "$NETWORK_DIR/local_edges_A.h5",
                "populations": {
                    "NodeA__NodeA__chemical": {
                        "type": "chemical"
                    }
                }
            },
            {
                "edges_file": "$NETWORK_DIR/local_edges_B.h5",
                "populations": {
                    "NodeB__NodeB__chemical": {
                        "type": "chemical"
                    }
                }
            },
            {
                "edges_file": "$NETWORK_DIR/edges_AB.h5",
                "populations": {
                    "NodeA__NodeB__chemical": {
                        "type": "chemical"
                    },
                    "NodeB__NodeA__chemical": {
                        "type": "chemical"
                    }
                }
            }
        ]
    }
}
